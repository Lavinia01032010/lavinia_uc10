{
  "name": "academia-viva-landing",
  "version": "1.0.0",
  "description": "Landing page responsiva para empresa de cursos online e presenciais, com Express, SQLite, Jest e Supertest.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jest": "^30.5.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "overrides": {
    "braces": "^3.0.3",
    "cross-spawn": "^6.0.6",
    "decode-uri-component": "^0.5.1",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "got": "^11.8.5"
  }
}
